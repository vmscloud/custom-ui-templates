# 애플리케이션
APP_NAME=Mozart Cloud Custom UI
APP_VERSION=0.1.0
DEBUG=false

# PostgreSQL 데이터베이스
DATABASE_URL=postgresql://mzcadm:mzcadm@203.231.40.243:5432/mzc_aps

# Query Executor (Trino/Iceberg 쿼리 실행 서비스)
QUERY_EXECUTOR_BASE_URL=http://aps-dev.petasys.com:18000

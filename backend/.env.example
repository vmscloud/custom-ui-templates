# ==============================================
# Backend 환경 변수 (.env 파일로 복사하여 사용)
# cp .env.example .env
# ==============================================

# 애플리케이션
APP_NAME=Mozart Cloud Custom UI
APP_VERSION=0.1.0
DEBUG=false

# PostgreSQL 데이터베이스
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# Query Executor (Trino/Iceberg 쿼리 실행 서비스)
QUERY_EXECUTOR_BASE_URL=http://192.168.1.250:18000
QUERY_EXECUTOR_DB_ALIAS=com
QUERY_EXECUTOR_LIMIT=50000
QUERY_TIMEOUT_SECONDS=120

# Trino 설정
TRINO_CATALOG=iceberg
TRINO_SCHEMA_APS=mzc_aps

# ==============================================
# Backend 환경 변수 예제
#
# 로드 순서 (뒤가 앞을 덮어씀):
#   1. .env              — 공통 기본값
#   2. .env.development  — 개발 환경 오버라이드
#   3. .env.local        — 로컬 개인 설정 (gitignore)
#   4. OS 환경변수        — 최우선 (docker, CI 등)
#
# 사용법:
#   cp .env.example .env
#   필요 시 .env.local 생성하여 개인 설정 덮어쓰기
# ==============================================

# 애플리케이션
APP_NAME=Mozart Cloud Custom UI
APP_VERSION=0.1.0
DEBUG=false
USE_MOCK=false

# Trino 연결 (database.py 직접 연결)
TRINO_HOST=<TRINO_HOST>
TRINO_PORT=18080
TRINO_USER=<TRINO_USER>
TRINO_CATALOG=iceberg
TRINO_SCHEMA=mzc_aps

# Trino PostgreSQL 카탈로그 (cfg_plan_config 등 설정 테이블)
TRINO_PG_CATALOG=postgresql
TRINO_PG_SCHEMA=mzc_aps

# Trino Iceberg 카탈로그 (rpt_*, out_*, ope_* 데이터 테이블)
TRINO_CATALOG_ICEBERG=iceberg
TRINO_SCHEMA_APS=mzc_aps

# Query Executor (Trino/Iceberg 쿼리 실행 서비스)
QUERY_EXECUTOR_BASE_URL=<QUERY_EXECUTOR_URL>
QUERY_EXECUTOR_DB_ALIAS=com
QUERY_EXECUTOR_LIMIT=50000
QUERY_TIMEOUT_SECONDS=120

# APS C# 백엔드 (프록시)
APS_BACKEND_BASE_URL=http://localhost:8080

# ==============================================
# Frontend 환경 변수 (.env 파일로 복사하여 사용)
# cp .env.example .env
# ==============================================

# 개발 서버 포트
VITE_DEV_PORT=5300

# 백엔드 API 프록시 대상 (개발 서버에서만 사용)
VITE_API_TARGET=http://localhost:8000

# APS C# 백엔드 프록시 대상 (계획 실행, 시나리오 등)
VITE_APS_API_TARGET=http://localhost:8080

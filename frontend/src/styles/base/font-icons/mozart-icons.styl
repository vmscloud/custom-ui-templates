fontagon-contents(value)
  content value

@font-face
  font-family "mozart-icons"
  src url("mozart-icons.eot?057b9b4fe8445edbc08d8c2c5a8b0d66?#iefix") format("embedded-opentype")
  src url("mozart-icons.woff2?057b9b4fe8445edbc08d8c2c5a8b0d66") format("woff2")
  src url("mozart-icons.woff?057b9b4fe8445edbc08d8c2c5a8b0d66") format("woff")

.mozart-icons, .m-icons
  -webkit-user-select none
  -moz-user-select none
  -ms-user-select none
  user-select none
  display inline-flex
  align-items center
  justify-content center
  vertical-align middle

.m-icons
  width 1em
  height 1em
  position relative
  fill currentColor

.mozart-icons
  font-family 'mozart-icons'
  font-weight normal
  font-style normal
  display inline-block
  line-height 1
  text-transform none
  letter-spacing normal
  word-wrap normal
  white-space nowrap
  direction ltr

  /* Support for all WebKit browsers. */
  -webkit-font-smoothing antialiased
  /* Support for Safari and Chrome. */
  text-rendering optimizeLegibility

  /* Support for Firefox. */
  -moz-osx-font-smoothing grayscale

  /* Support for IE. */
  font-feature-settings 'liga'



# MCP 서버 비밀정보 템플릿.
# 셋업: 이 파일을 .env 로 복사한 뒤 값을 실제 비밀로 채우세요.
#   PowerShell:  Copy-Item .env.example .env
#   bash/zsh:    cp .env.example .env
# .env 는 .gitignore 로 무시되며 절대 커밋하면 안 됩니다.
#
# 이 값들은 tools/setup-local-mcp.ps1 (make mcp-local) 이 읽어, 내부 MCP 서버를
# Claude Code 의 "local 스코프"(레포 밖 ~/.claude.json)에 등록합니다.
# 따라서 내부 서버 정의·이름·개수는 공개 .mcp.json 에 드러나지 않습니다.
#
# 인식 규칙 (setup-local-mcp):
#   - GITHUB_PERSONAL_ACCESS_TOKEN  -> github 서버 등록
#   - POSTGRES_<NAME>_URL           -> postgres-<name> 서버 등록 (키마다 1개)
# 아래는 형식 예시입니다. 실제 키 이름/개수는 환경에 맞게 자유롭게 정의하세요.

# GitHub MCP — https://github.com/settings/tokens 에서 발급한 PAT
#GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Postgres MCP — 형식: postgresql://<user>:<password>@<host>:<port>/<database>
# 비밀번호 특수문자는 URL 인코딩 (예: ! -> %21)
#POSTGRES_SAMPLE_URL=postgresql://USER:PASSWORD@HOST:5432/dbname

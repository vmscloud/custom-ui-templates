{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/tools/node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js",
        "--browserUrl=http://127.0.0.1:9222"
      ],
      "env": {}
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/tools/node_modules/@modelcontextprotocol/server-sequential-thinking/dist/index.js"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/tools/node_modules/@playwright/mcp/cli.js"
      ]
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena@v1.5.1",
        "serena",
        "start-mcp-server",
        "--project",
        "${CLAUDE_PROJECT_DIR:-.}",
        "--context",
        "ide-assistant",
        "--open-web-dashboard",
        "False"
      ]
    }
  }
}
